# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (from Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (from Project Settings > API)
SUPABASE_KEY=your-supabase-anon-key

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Your Gmail address used to send reminders
GMAIL_SENDER=your-email@gmail.com

# Gmail App Password (not your account password)
# Enable 2FA → Google Account > Security > App Passwords → Generate
GMAIL_APP_PASSWORD=your-16-character-app-password

# ── Application ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ── Frontend (Next.js public env vars) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
